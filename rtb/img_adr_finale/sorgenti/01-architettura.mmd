flowchart LR
  U(["<b>Utente</b>"])
  AM(["<b>Amministratore</b>"])

  subgraph DEV["<b>Dispositivo Fossdot</b>"]
    direction TB
    MIC["Microfoni"]
    FW["<b>Firmware</b><br/>parola di attivazione<br/>(anche per interrompere),<br/>stato del dispositivo"]
    SPK["Altoparlante"]
    LED["LED di stato"]
    BTN["Pulsanti"]
    MIC --> FW
    BTN --> FW
    FW --> SPK
    FW --> LED
  end

  subgraph SRV["<b>Server di bridging</b> (installato dall'utente)"]
    direction TB
    RX["Ricezione dell'audio<br/>e fine della richiesta"]
    STT["Trascrizione<br/>(STT)"]
    ORC["<b>Gestione della conversazione</b><br/>contesto, skill, agent"]
    TTS["Sintesi vocale<br/>(TTS)"]
    DB[("Dati: account,<br/>dispositivi, configurazioni")]
    RX --> STT --> ORC --> TTS
    ORC --- DB
  end

  subgraph WEB["<b>Web app</b>"]
    UI["Account, case, dispositivi,<br/>provider, skill, privacy"]
  end

  LLM["<b>Provider AI</b><br/>cloud o locale"]
  MCPS["<b>Server MCP</b><br/>strumenti esterni"]

  U -- "voce" --> MIC
  SPK -- "risposta" --> U
  LED -.-> U
  U --> BTN
  FW == "audio della richiesta" ==> RX
  TTS == "audio della risposta" ==> FW
  AM --> UI
  UI -- "configurazione" --> DB
  ORC <--> LLM
  ORC <--> MCPS
