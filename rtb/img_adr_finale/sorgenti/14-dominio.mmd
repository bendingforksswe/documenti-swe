classDiagram
  direction LR
  class Account {
    email
    passwordHash
    nome
    creatoIl
  }
  class Casa {
    nome
    lingua
    fusoOrario
  }
  class Appartenenza {
    ruolo: Amministratore | Membro
  }
  class Stanza {
    nome
  }
  class Dispositivo {
    id
    nome
    credenziali
    versioneFirmware
    stato: online | offline
    ultimoContatto
  }
  class ConfigurazioneProvider {
    tipo
    endpoint
    chiaveApi (cifrata)
    modello
  }
  class ConfigurazioneVoce {
    lingua
    voceTTS
    wakeWord
  }
  class Skill {
    nome
    descrizione
    istruzioni
    versione
    parametri
  }
  class ServerMCP {
    nome
    url
    autenticazione
    strumenti
  }
  class Contesto {
    testoMarkdown
    aggiornatoIl
  }
  class Conversazione {
    inizio
    trascrizioni
    scadenza
  }
  class VersioneFirmware {
    numero
    firma
    note
  }
  Account "1" -- "*" Appartenenza
  Casa "1" -- "*" Appartenenza
  Casa "1" *-- "*" Stanza
  Casa "1" *-- "*" Dispositivo
  Stanza "0..1" o-- "*" Dispositivo
  Casa "1" -- "1..*" ConfigurazioneProvider
  Dispositivo "*" --> "0..1" ConfigurazioneProvider : usa
  Dispositivo "1" -- "1" ConfigurazioneVoce
  Casa "1" -- "*" Skill : installate
  Dispositivo "*" -- "*" Skill : abilitate
  Casa "1" -- "*" ServerMCP
  Dispositivo "1" -- "0..1" Contesto
  Dispositivo "1" -- "*" Conversazione
  Dispositivo "*" --> "1" VersioneFirmware
